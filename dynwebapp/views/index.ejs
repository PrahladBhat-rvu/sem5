<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Game Library</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 40px;
            font-family: Arial, sans-serif;
            background: #111;
            color: white;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        h1 {
            margin-bottom: 35px;
        }

        .games {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .game-card {
            background: #1d1d1d;
            border-radius: 12px;
            overflow: hidden;
            text-decoration: none;
            color: white;
            transition: 0.2s;
        }

        .game-card:hover {
            transform: translateY(-6px);
        }

        .game-card img {
            width: 100%;
            height: 420px;
            object-fit: cover;
            display: block;
        }

        .game-info {
            padding: 20px;
        }

        .game-info h2 {
            margin: 0 0 10px;
            font-size: 20px;
        }

        .game-info p {
            color: #999;
            margin: 6px 0;
        }

        @media (max-width: 800px) {

            .games {
                grid-template-columns: 1fr;
            }

        }

    </style>

</head>


<body>

<div class="container">

    <h1>Game Library</h1>

    <div class="games">

        <% games.forEach(game => { %>

            <a
                href="/game/<%= game.id %>"
                class="game-card"
            >

                <img
                    src="<%= game.poster %>"
                    alt="<%= game.title %>"
                >

                <div class="game-info">

                    <h2>
                        <%= game.title %>
                    </h2>

                    <p>
                        <%= game.genre %>
                    </p>

                    <p>
                        <%= game.releaseYear %>
                    </p>

                </div>

            </a>

        <% }) %>

    </div>

</div>

</body>

</html>