<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="container">

    <div class="card">
        <h1>User Profile</h1>

        <h2>
            <%= user.firstName %> <%= user.lastName %>
        </h2>

        <p class="info">
            <strong>Email:</strong> <%= user.email %>
        </p>

        <p class="info">
            <strong>Phone:</strong> <%= user.phone %>
        </p>
    </div>

    <div class="card">

        <h2>Children</h2>

        <% if (children.length === 0) { %>

            <p class="empty">
                No children found for this user.
            </p>

        <% } else { %>

            <% children.forEach(child => { %>

                <div class="child-card">

                    <h3>
                        <%= child.firstName %> <%= child.lastName %>
                    </h3>

                    <p>
                        <strong>Age:</strong>
                        <%= child.age %>
                    </p>

                    <p>
                        <strong>Email:</strong>
                        <%= child.email %>
                    </p>

                    <a
                        class="button primary"
                        href="/children/<%= child._id %>/edit"
                    >
                        Update
                    </a>

                    <button
                        class="danger"
                        onclick="deleteChild('<%= child._id %>')"
                    >
                        Delete
                    </button>

                </div>

            <% }); %>

        <% } %>

        <a
            class="button"
            href="/users/<%= user._id %>/children/add"
        >
            + Add Child
        </a>

    </div>

</div>

<script>
async function deleteChild(childId) {

    if (!confirm("Are you sure you want to delete this child?")) {
        return;
    }

    const response = await fetch(`/children/${childId}`, {
        method: "DELETE"
    });

    if (response.ok) {
        location.reload();
    } else {
        alert("Error deleting child");
    }
}
</script>

</body>

</html>