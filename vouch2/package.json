{
  "name": "vouch",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node backend/server.js",
    "backend": "npm start --prefix backend",
    "start": "node backend/server.js",
    "deploy": "npm run build && wrangler deploy"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2",
    "wrangler": "^4.126.0"
  }
}
