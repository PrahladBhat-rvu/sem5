<%- include('partials/header', { title }) %>
<div class="detail-top"><a class="back-link" href="/lost-items">← All lost items</a><span class="status status-lost">Lost report</span></div>
<section class="detail-hero"><div class="detail-icon lost-icon">⌕</div><div class="detail-main"><span class="item-category"><%= item.category %></span><h1><%= item.itemName %></h1><p class="detail-description"><%= item.description %></p><div class="detail-meta"><span>⌖ <b>Last seen</b> <%= item.lastSeenLocation %></span><span>◷ <b>Date lost</b> <%= new Date(item.dateLost).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span></div></div></section>
<section class="detail-panel reporter-panel"><div class="section-heading"><h2>Reported by</h2></div><div class="reporter-row"><div class="person-avatar"><%= item.reportedBy.fullName.split(' ').map(n => n[0]).slice(0,2).join('').toUpperCase() %></div><div><b><%= item.reportedBy.fullName %></b><small><%= item.reportedBy.department %></small><small><%= item.reportedBy.email %> · <%= item.reportedBy.contactNumber %></small></div><a class="text-link" href="/students/<%= item.reportedBy._id %>">View profile ↗</a></div></section>
<%- include('partials/footer') %>
