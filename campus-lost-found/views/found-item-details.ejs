<%- include('partials/header', { title }) %>
<div class="detail-top"><a class="back-link" href="/found-items">← All found items</a><span class="status <%= item.status === 'Returned' ? 'status-returned' : 'status-available' %>"><%= item.status %></span></div>
<section class="detail-hero"><div class="detail-icon found-icon">✓</div><div class="detail-main"><span class="item-category"><%= item.category %></span><h1><%= item.itemName %></h1><p class="detail-description"><%= item.description %></p><div class="detail-meta"><span>⌖ <b>Found at</b> <%= item.foundLocation %></span><span>◷ <b>Date found</b> <%= new Date(item.dateFound).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span></div><div class="reporter-inline">Reported by <a href="/students/<%= item.reportedBy._id %>"><%= item.reportedBy.fullName %></a> · <%= item.reportedBy.department %></div></div></section>
<% if (item.status === 'Available' && currentStudentId && String(item.reportedBy._id) !== String(currentStudentId)) { %><section class="claim-panel"><div><div class="eyebrow">THINK THIS IS YOURS?</div><h2>Make your claim</h2><p>Explain how you can identify this item. Specific details help the finder verify ownership.</p></div><form action="/found-items/<%= item._id %>/claims" method="POST" class="claim-form"><label>Why does this item belong to you?<textarea name="reason" minlength="10" maxlength="1000" required rows="3" placeholder="Mention a unique mark, what was inside, or another identifying detail..."></textarea></label><button class="button button-primary" type="submit">Submit claim ↗</button></form></section><% } else if (!currentStudentId && item.status === 'Available') { %><div class="inline-notice">Create or select a student profile to submit a claim. <a href="/students/new">Select profile ↗</a></div><% } else if (item.status === 'Returned') { %><div class="inline-notice returned-notice">✓ This item has been marked as returned. New claims are closed.</div><% } %>
<section class="section-block claims-section"><div class="section-heading"><div><div class="eyebrow">CLAIM REVIEW</div><h2>Claims for this item</h2></div><span class="count-pill"><%= claims.length %></span></div>
<% if (!claims.length) { %><div class="empty-state compact-empty"><div class="empty-icon">✳</div><h3>No claims submitted</h3><p>Claims will appear here once a student submits one.</p></div><% } else { %><div class="claims-list"><% claims.forEach(claim => { %><article class="claim-card"><div class="claim-head"><div class="person-avatar small-avatar"><%= claim.claimedBy.fullName.split(' ').map(n => n[0]).slice(0,2).join('').toUpperCase() %></div><div class="claim-person"><b><%= claim.claimedBy.fullName %></b><small><%= claim.claimedBy.department %> · <%= new Date(claim.createdAt).toLocaleDateString('en-IN') %></small></div><span class="status <%= claim.status === 'Pending' ? 'status-pending' : claim.status === 'Approved' ? 'status-available' : 'status-rejected' %>"><%= claim.status %></span></div><p class="claim-reason"><%= claim.reason %></p>
<% if (isReporter && claim.status === 'Pending' && item.status === 'Available') { %><div class="claim-actions"><form action="/claims/<%= claim._id %>/status?_method=PATCH" method="POST" data-confirm="Approve this claim? The item will be marked Returned and other pending claims rejected."><input type="hidden" name="status" value="Approved"><button class="button button-primary" type="submit">✓ Approve & return</button></form><form action="/claims/<%= claim._id %>/status?_method=PATCH" method="POST" data-confirm="Reject this claim?"><input type="hidden" name="status" value="Rejected"><button class="button button-ghost" type="submit">Reject</button></form></div><% } %>
</article><% }) %></div><% } %>
<% if (isReporter) { %><div class="owner-note">You reported this item, so you can review and decide on its claims.</div><% } %>
</section>
<%- include('partials/footer') %>
