<%- include('partials/header', { title }) %>
<div class="detail-top"><a class="back-link" href="/students">← Student directory</a><span class="eyebrow">STUDENT PROFILE</span></div>
<section class="profile-hero"><div class="profile-avatar"><%= student.fullName.split(' ').map(n => n[0]).slice(0,2).join('').toUpperCase() %></div><div class="profile-main"><h1><%= student.fullName %></h1><p><%= student.department %></p><div class="profile-contact"><span>✉ <%= student.email %></span><span>☎ <%= student.contactNumber %></span></div></div><% if (String(currentStudentId) !== String(student._id)) { %><form action="/session/student" method="POST"><input type="hidden" name="studentId" value="<%= student._id %>"><button class="button button-primary" type="submit">Act as this student</button></form><% } else { %><span class="status status-available">Current profile ✓</span><% } %></section>
<div class="two-column-details"><section class="detail-panel"><div class="section-heading"><h2>Lost reports</h2><span class="count-pill"><%= lostItems.length %></span></div><% if (!lostItems.length) { %><p class="muted">No lost-item reports from this student.</p><% } else { lostItems.forEach(item => { %><a class="mini-row" href="/lost-items/<%= item._id %>"><span><b><%= item.itemName %></b><small><%= item.lastSeenLocation %></small></span><span>↗</span></a><% }) } %></section>
<section class="detail-panel"><div class="section-heading"><h2>Found reports</h2><span class="count-pill"><%= foundItems.length %></span></div><% if (!foundItems.length) { %><p class="muted">No found-item reports from this student.</p><% } else { foundItems.forEach(item => { %><a class="mini-row" href="/found-items/<%= item._id %>"><span><b><%= item.itemName %></b><small><%= item.foundLocation %></small></span><span>↗</span></a><% }) } %></section></div>
<%- include('partials/footer') %>
