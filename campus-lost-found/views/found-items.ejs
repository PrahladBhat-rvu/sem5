<%- include('partials/header', { title }) %>
<section class="page-heading"><div><div class="eyebrow">HELP GOOD THINGS GET HOME</div><h1>Found <span>items</span></h1><p>Something look familiar? Check the details and submit a claim.</p></div><a class="button button-primary" href="/found-items/new">+ Report found item</a></section>
<form class="filter-bar" method="GET" action="/found-items"><label class="search-field"><span>⌕</span><input name="q" value="<%= q %>" placeholder="Search item or location..."></label><select name="category"><option value="">All categories</option><% categories.forEach(c => { %><option value="<%= c %>" <%= selectedCategory === c ? 'selected' : '' %>><%= c %></option><% }) %></select><select name="status"><option value="">All statuses</option><option value="Available" <%= selectedStatus === 'Available' ? 'selected' : '' %>>Available</option><option value="Returned" <%= selectedStatus === 'Returned' ? 'selected' : '' %>>Returned</option></select><button class="button button-dark" type="submit">Filter ↗</button><% if(q || selectedCategory || selectedStatus) { %><a class="clear-link" href="/found-items">Clear</a><% } %></form>
<div class="results-label"><span><strong><%= items.length %></strong> reports</span><span>Sorted by newest</span></div>
<% if (!items.length) { %><div class="empty-state"><div class="empty-icon">⌕</div><h3>No found items yet</h3><p>When an item is reported, it will appear here. You can be the first to help.</p><a class="button button-primary" href="/found-items/new">Report found item</a></div><% } else { %><div class="item-grid listing-grid"><% items.forEach((item, index) => { %><a class="item-card" href="/found-items/<%= item._id %>"><div class="item-card-top"><span class="item-emoji"><%= ['◉','▣','⌘','◈'][index % 4] %></span><span class="status <%= item.status === 'Returned' ? 'status-returned' : 'status-available' %>"><%= item.status %></span></div><span class="item-category"><%= item.category %></span><h3><%= item.itemName %></h3><p class="item-description"><%= item.description %></p><p class="item-location">⌖ <%= item.foundLocation %></p><div class="item-card-footer"><span><%= item.reportedBy ? item.reportedBy.fullName : 'Student' %></span><span>↗</span></div></a><% }) %></div><% } %>
<%- include('partials/footer') %>
