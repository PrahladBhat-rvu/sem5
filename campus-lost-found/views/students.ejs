<%- include('partials/header', { title }) %>
<section class="page-heading"><div><div class="eyebrow">CAMPUS DIRECTORY</div><h1>Student <span>profiles</span></h1><p>Choose a profile to act as that student for this demo.</p></div><a class="button button-primary" href="/students/new">+ Create profile</a></section>
<% if (!students.length) { %><div class="empty-state"><div class="empty-icon">♙</div><h3>No student profiles yet</h3><p>Create a profile before submitting a report.</p><a class="button button-primary" href="/students/new">Create first profile</a></div><% } else { %>
<div class="directory-list"><% students.forEach((student, i) => { %><div class="directory-card"><div class="person-avatar"><%= student.fullName.split(' ').map(n => n[0]).slice(0,2).join('').toUpperCase() %></div><div class="directory-info"><a href="/students/<%= student._id %>"><h3><%= student.fullName %></h3></a><p><%= student.department %> · <%= student.email %></p></div><form action="/session/student" method="POST"><input type="hidden" name="studentId" value="<%= student._id %>"><button class="button <%= String(currentStudentId) === String(student._id) ? 'button-ghost' : 'button-primary' %>" type="submit"><%= String(currentStudentId) === String(student._id) ? 'Selected ✓' : 'Act as student' %></button></form></div><% }) %></div><% } %>
<%- include('partials/footer') %>
