<%- include('partials/header', { title }) %>
<section class="page-heading"><div><div class="eyebrow">HELP SOMEONE FIND THEIR THINGS</div><h1>Lost <span>items</span></h1><p>Browse what has gone missing around campus.</p></div><a class="button button-primary" href="/lost-items/new">+ Report lost item</a></section>
<form class="filter-bar" method="GET" action="/lost-items"><label class="search-field"><span>⌕</span><input name="q" value="<%= q %>" placeholder="Search item or location..."></label><select name="category"><option value="">All categories</option><% categories.forEach(c => { %><option value="<%= c %>" <%= selectedCategory === c ? 'selected' : '' %>><%= c %></option><% }) %></select><button class="button button-dark" type="submit">Filter ↗</button><% if(q || selectedCategory) { %><a class="clear-link" href="/lost-items">Clear</a><% } %></form>
<div class="results-label"><span><strong><%= items.length %></strong> reports</span><span>Sorted by newest</span></div>
<% if (!items.length) { %><div class="empty-state"><div class="empty-icon">⌕</div><h3>No matching reports</h3><p>Try a different search, or add a report to help the community.</p><a class="button button-primary" href="/lost-items/new">Report lost item</a></div><% } else { %><div class="item-grid listing-grid"><% items.forEach((item, index) => { %><a class="item-card" href="/lost-items/<%= item._id %>"><div class="item-card-top"><span class="item-emoji"><%= ['◉','▣','⌘','◈'][index % 4] %></span><span class="status status-lost">Lost</span></div><span class="item-category"><%= item.category %></span><h3><%= item.itemName %></h3><p class="item-description"><%= item.description %></p><p class="item-location">⌖ <%= item.lastSeenLocation %></p><div class="item-card-footer"><span><%= item.reportedBy ? item.reportedBy.fullName : 'Student' %></span><span>↗</span></div></a><% }) %></div><% } %>
<%- include('partials/footer') %>
